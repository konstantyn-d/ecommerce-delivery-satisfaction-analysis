# Raw data is NOT committed (licence CC BY-NC-SA 4.0, ~120 MB).
# Download instructions are in README.md.
data/raw/*
!data/raw/.gitkeep

# Build artefacts: the DuckDB database and the Parquet exports for Power BI.
# Both are rebuilt from the raw CSV files by `python run_sql.py`.
data/processed/*
!data/processed/.gitkeep
*.duckdb
*.duckdb.wal

# Python
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Power BI temporary files
*.pbix.tmp
~$*
