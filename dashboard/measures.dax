// =====================================================================================================
// DAX measures of the Olist delivery and satisfaction dashboard
// Generated by dashboard/build_pbip.py from the same list that builds the semantic model.
// Every measure implements a definition from docs/metric_definitions.md; with no filter applied it must
// show the value in dashboard/reference_values.md.
//
// Rules behind the formulas:
//   1. Rates are DIVIDE(numerator, denominator) of totals, never an average of row-level ratios.
//   2. DIVIDE returns blank instead of an error when the denominator is 0.
//   3. On fact_order_items one order has several rows, so orders are counted with DISTINCTCOUNT.
// =====================================================================================================

// ---- Volume and value ------------------------------------------------------------------------

// Number of orders, all statuses.   Format: #,0   Table: fact_orders
Orders = COUNTROWS ( fact_orders )

// Value of the products ordered, in BRL, without freight.   Format: #,0   Table: fact_orders
GMV = SUM ( fact_orders[items_value] )

// Orders that have item rows; the orders without items have no value.   Format: #,0   Table: fact_orders
Orders with Items = CALCULATE ( [Orders], fact_orders[has_items] = TRUE () )

// GMV per order that has items.   Format: #,0.00   Table: fact_orders
Average Order Value = DIVIDE ( [GMV], [Orders with Items] )

// Freight as a share of what the customer pays (products plus freight). A ratio of totals.   Format: 0.0%   Table: fact_orders
Freight Share = DIVIDE ( SUM ( fact_orders[freight_value] ), SUM ( fact_orders[order_total] ) )


// ---- Delivery --------------------------------------------------------------------------------

// Orders that reached the customer and have a delivery date.   Format: #,0   Table: fact_orders
Delivered Orders = CALCULATE ( [Orders], fact_orders[is_delivered] = TRUE () )

// Orders delivered on or before the promised date.   Format: #,0   Table: fact_orders
On-time Orders = CALCULATE ( [Orders], fact_orders[delivery_outcome] = "On time" )

// Orders delivered after the promised date.   Format: #,0   Table: fact_orders
Late Orders = CALCULATE ( [Orders], fact_orders[delivery_outcome] = "Late" )

// Orders that did not end as a delivery.   Format: #,0   Table: fact_orders
Not Delivered Orders = CALCULATE ( [Orders], fact_orders[delivery_outcome] = "Not delivered" )

// Share of delivered orders that kept the promised date.   Format: 0.0%   Table: fact_orders
On-time Rate = DIVIDE ( [On-time Orders], [Delivered Orders] )

// Share of delivered orders that arrived after the promised date.   Format: 0.0%   Table: fact_orders
Late Rate = DIVIDE ( [Late Orders], [Delivered Orders] )

// Share of all orders that were never delivered.   Format: 0.0%   Table: fact_orders
Not-delivered Rate = DIVIDE ( [Not Delivered Orders], [Orders] )

// Average number of days late, late orders only.   Format: 0.0   Table: fact_orders
Avg Delay (Late) = CALCULATE ( AVERAGE ( fact_orders[delay_days] ), fact_orders[delivery_outcome] = "Late" )

// Median number of days late, late orders only.   Format: 0   Table: fact_orders
Median Delay (Late) = CALCULATE ( MEDIAN ( fact_orders[delay_days] ), fact_orders[delivery_outcome] = "Late" )

// Median number of calendar days from purchase to delivery.   Format: 0   Table: fact_orders
Median Delivery Days = MEDIAN ( fact_orders[delivery_days] )

// Of the late orders, the share that the seller handed to the carrier after the shipping deadline.   Format: 0.0%   Table: fact_orders
Late Orders Handed Over Late by Seller =
	DIVIDE (
	    CALCULATE ( [Late Orders], fact_orders[is_seller_handover_late] = TRUE () ),
	    [Late Orders]
	)

// The national late rate, ignoring any state or region filter.   Format: 0.0%   Table: fact_orders
Late Rate (All States) = CALCULATE ( [Late Rate], REMOVEFILTERS ( dim_geography ) )


// ---- Formatting ------------------------------------------------------------------------------

// Bar colour: accent when the state is above the national late rate, grey otherwise.   Table: fact_orders
Colour Late Rate = IF ( [Late Rate] > [Late Rate (All States)], "#eb6834", "#a8a7a0" )


// ---- Satisfaction ----------------------------------------------------------------------------

// Orders that have a review.   Format: #,0   Table: fact_orders
Reviewed Orders = CALCULATE ( [Orders], fact_orders[has_review] = TRUE () )

// Average review score from 1 to 5; orders without a review are ignored.   Format: 0.00   Table: fact_orders
Avg Review Score = AVERAGE ( fact_orders[review_score] )

// Orders with a 1-2 star review.   Format: #,0   Table: fact_orders
Low Score Orders = CALCULATE ( [Orders], fact_orders[is_low_score] = TRUE () )

// Share of reviewed orders with a 1-2 star review: the main outcome metric.   Format: 0.0%   Table: fact_orders
Low Score Share = DIVIDE ( [Low Score Orders], [Reviewed Orders] )

// Share of reviews that include a written comment.   Format: 0.0%   Table: fact_orders
Comment Share = DIVIDE ( CALCULATE ( [Orders], fact_orders[has_comment] = TRUE () ), [Reviewed Orders] )

// Each delivery outcome's share of all orders.   Format: 0.0%   Table: fact_orders
Share of Orders =
	DIVIDE (
	    [Orders],
	    CALCULATE ( [Orders], REMOVEFILTERS ( fact_orders[delivery_outcome], fact_orders[delivery_outcome_sort] ) )
	)

// Each delivery outcome's share of all 1-2 star reviews.   Format: 0.0%   Table: fact_orders
Share of Low Score Reviews =
	DIVIDE (
	    [Low Score Orders],
	    CALCULATE ( [Low Score Orders], REMOVEFILTERS ( fact_orders[delivery_outcome], fact_orders[delivery_outcome_sort] ) )
	)

// Share of 1-2 star reviews of orders with one item.   Format: 0.0%   Table: fact_orders
Low Score Share Single Item = CALCULATE ( [Low Score Share], fact_orders[order_size] = "Single item" )

// Share of 1-2 star reviews of orders with two or more items.   Format: 0.0%   Table: fact_orders
Low Score Share Several Items = CALCULATE ( [Low Score Share], fact_orders[order_size] = "Several items" )


// ---- Formatting ------------------------------------------------------------------------------

// Bar colour: reference colour for on-time orders, accent colour otherwise.   Table: fact_orders
Colour Delivery = IF ( SELECTEDVALUE ( fact_orders[delivery_outcome] ) = "On time", "#2a78d6", "#eb6834" )

// Page 1 headline that updates with the filters.   Table: fact_orders
Title Overview =
	VAR ProblemOrders =
	    DIVIDE ( [Late Orders] + [Not Delivered Orders], [Orders] )
	VAR ProblemReviews =
	    DIVIDE (
	        CALCULATE ( [Low Score Orders], fact_orders[delivery_outcome] IN { "Late", "Not delivered" } ),
	        [Low Score Orders]
	    )
	RETURN
	    "Late and undelivered orders are " & FORMAT ( ProblemOrders, "0.0%" )
	        & " of orders but account for " & FORMAT ( ProblemReviews, "0%" )
	        & " of all 1-2 star reviews"


// ---- Customers -------------------------------------------------------------------------------

// Number of people (customer_unique_id) with an order in the period.   Format: #,0   Table: dim_customer
Customers = COUNTROWS ( dim_customer )

// People who ordered on more than one day.   Format: #,0   Table: dim_customer
Repeat Customers = CALCULATE ( [Customers], dim_customer[is_repeat_customer] = TRUE () )

// Share of customers who came back on a later day. Whole period only.   Format: 0.00%   Table: dim_customer
Repeat Purchase Rate = DIVIDE ( [Repeat Customers], [Customers] )


// ---- Sellers and categories ------------------------------------------------------------------

// Value of the items sold, in BRL.   Format: #,0   Table: fact_order_items
Item GMV = SUM ( fact_order_items[price] )

// Orders that contain at least one item of the seller or category.   Format: #,0   Table: fact_order_items
Item Orders = DISTINCTCOUNT ( fact_order_items[order_id] )

// Delivered orders that contain the seller or category.   Format: #,0   Table: fact_order_items
Item Delivered Orders = CALCULATE ( [Item Orders], fact_order_items[is_delivered] = TRUE () )

// Late orders that contain the seller or category.   Format: #,0   Table: fact_order_items
Item Late Orders = CALCULATE ( [Item Orders], fact_order_items[delivery_outcome] = "Late" )

// Late rate of a seller or category.   Format: 0.0%   Table: fact_order_items
Item Late Rate = DIVIDE ( [Item Late Orders], [Item Delivered Orders] )

// Reviewed orders that contain the seller or category.   Format: #,0   Table: fact_order_items
Item Reviewed Orders = CALCULATE ( [Item Orders], fact_order_items[has_review] = TRUE () )

// Orders with a 1-2 star review that contain the seller or category.   Format: #,0   Table: fact_order_items
Item Low Score Orders = CALCULATE ( [Item Orders], fact_order_items[is_low_score] = TRUE () )

// Share of 1-2 star reviews of a seller or category.   Format: 0.0%   Table: fact_order_items
Item Low Score Share = DIVIDE ( [Item Low Score Orders], [Item Reviewed Orders] )

// Average score of a seller or category: one score per order, then the average of the orders.   Format: 0.00   Table: fact_order_items
Item Avg Review Score =
	AVERAGEX (
	    VALUES ( fact_order_items[order_id] ),
	    CALCULATE ( MAX ( fact_order_items[review_score] ) )
	)

// The overall share of 1-2 star reviews on item level, ignoring the category.   Format: 0.0%   Table: fact_order_items
Low Score Share (All Categories) = CALCULATE ( [Item Low Score Share], REMOVEFILTERS ( dim_product ) )


// ---- Review coding ---------------------------------------------------------------------------

// Number of coded 1-2 star reviews in the sample.   Format: #,0   Table: coded_reviews
Coded Reviews = COUNTROWS ( coded_reviews )

// Share of a complaint category inside the delivery group shown.   Format: 0%   Table: coded_reviews
Complaint Share =
	DIVIDE (
	    [Coded Reviews],
	    CALCULATE ( [Coded Reviews], REMOVEFILTERS ( coded_reviews[primary_category] ) )
	)
