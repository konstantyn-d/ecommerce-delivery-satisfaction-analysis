	partition fact_orders = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents(DataFolder & "data\processed\fact_orders.parquet")),
				    Typed = Table.TransformColumnTypes(Source, {{"order_id", type text}, {"customer_unique_id", type text}, {"purchase_date", type date}, {"customer_state", type text}, {"order_status", type text}, {"delivery_outcome", type text}, {"delivery_outcome_sort", Int64.Type}, {"delay_band", type text}, {"delay_band_sort", Int64.Type}, {"is_delivered", type logical}, {"is_on_time", type logical}, {"promised_days", Int64.Type}, {"delivery_days", Int64.Type}, {"delay_days", Int64.Type}, {"handling_days", Int64.Type}, {"transit_days", Int64.Type}, {"is_seller_handover_late", type logical}, {"has_items", type logical}, {"item_count", Int64.Type}, {"order_size", type text}, {"seller_count", Int64.Type}, {"items_value", type number}, {"freight_value", type number}, {"order_total", type number}, {"is_same_state", type logical}, {"has_review", type logical}, {"review_score", Int64.Type}, {"is_low_score", type logical}, {"has_comment", type logical}, {"review_before_delivery", type logical}, {"customer_order_number", Int64.Type}})
				in
				    Typed

	annotation PBI_ResultType = Table
