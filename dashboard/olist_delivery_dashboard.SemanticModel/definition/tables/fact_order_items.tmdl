		sourceColumn: is_low_score

	partition fact_order_items = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents(DataFolder & "data\processed\fact_order_items.parquet")),
				    Typed = Table.TransformColumnTypes(Source, {{"order_id", type text}, {"order_item_id", Int64.Type}, {"product_id", type text}, {"seller_id", type text}, {"purchase_date", type date}, {"customer_state", type text}, {"price", type number}, {"freight_value", type number}, {"is_same_state", type logical}, {"is_seller_handover_late", type logical}, {"is_multi_seller_order", type logical}, {"delivery_outcome", type text}, {"is_delivered", type logical}, {"is_on_time", type logical}, {"delay_days", Int64.Type}, {"has_review", type logical}, {"review_score", Int64.Type}, {"is_low_score", type logical}})
				in
				    Typed

	annotation PBI_ResultType = Table
