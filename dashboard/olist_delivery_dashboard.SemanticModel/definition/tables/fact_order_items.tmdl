table fact_order_items
	lineageTag: 047784c8-f439-5501-b709-d502f653c84b

	/// Value of the items sold, in BRL.
	measure 'Item GMV' = SUM ( fact_order_items[price] )
		formatString: #,0
		displayFolder: 5 Sellers and categories
		lineageTag: 2ff9ef4d-c9b7-52c0-b20a-d3cc1d1cc185

	/// Orders that contain at least one item of the seller or category.
	measure 'Item Orders' = DISTINCTCOUNT ( fact_order_items[order_id] )
		formatString: #,0
		displayFolder: 5 Sellers and categories
		lineageTag: e008210a-9c3d-586f-a840-3d8a16fb681f

	/// Delivered orders that contain the seller or category.
	measure 'Item Delivered Orders' = CALCULATE ( [Item Orders], fact_order_items[is_delivered] = TRUE () )
		formatString: #,0
		displayFolder: 5 Sellers and categories
		lineageTag: b3edb234-90ea-564e-b036-48e17bf24840

	/// Late orders that contain the seller or category.
	measure 'Item Late Orders' = CALCULATE ( [Item Orders], fact_order_items[delivery_outcome] = "Late" )
		formatString: #,0
		displayFolder: 5 Sellers and categories
		lineageTag: fb47c124-b09a-582e-b62f-a8179fe3abf0

	/// Late rate of a seller or category.
	measure 'Item Late Rate' = DIVIDE ( [Item Late Orders], [Item Delivered Orders] )
		formatString: 0.0%
		displayFolder: 5 Sellers and categories
		lineageTag: 457d8f9e-a786-50cf-a7c6-4abaa1a7eb1a

	/// Reviewed orders that contain the seller or category.
	measure 'Item Reviewed Orders' = CALCULATE ( [Item Orders], fact_order_items[has_review] = TRUE () )
		formatString: #,0
		displayFolder: 5 Sellers and categories
		lineageTag: 612821f0-cc0f-58a6-9ddd-f1b3bee8f235

	/// Orders with a 1-2 star review that contain the seller or category.
	measure 'Item Low Score Orders' = CALCULATE ( [Item Orders], fact_order_items[is_low_score] = TRUE () )
		formatString: #,0
		displayFolder: 5 Sellers and categories
		lineageTag: eb8d31d2-e30f-5bcb-83ed-6e6540069fdb

	/// Share of 1-2 star reviews of a seller or category.
	measure 'Item Low Score Share' = DIVIDE ( [Item Low Score Orders], [Item Reviewed Orders] )
		formatString: 0.0%
		displayFolder: 5 Sellers and categories
		lineageTag: 12491545-3323-51af-a11a-fb748cb1b11c

	/// Average score of a seller or category: one score per order, then the average of the orders.
	measure 'Item Avg Review Score' =
			AVERAGEX (
			    VALUES ( fact_order_items[order_id] ),
			    CALCULATE ( MAX ( fact_order_items[review_score] ) )
			)
		formatString: 0.00
		displayFolder: 5 Sellers and categories
		lineageTag: 1abfb57c-4818-5c67-a98b-400bae6bb649

	/// The overall share of 1-2 star reviews on item level, ignoring the category.
	measure 'Low Score Share (All Categories)' = CALCULATE ( [Item Low Score Share], REMOVEFILTERS ( dim_product ) )
		formatString: 0.0%
		displayFolder: 5 Sellers and categories
		lineageTag: 89da8c72-94bf-5697-aadb-1047117dbe13

