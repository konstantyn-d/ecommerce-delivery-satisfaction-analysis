model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["DataFolder", "fact_orders", "fact_order_items", "dim_customer", "dim_seller", "dim_product", "dim_date", "dim_geography", "coded_reviews"]

annotation __PBI_TimeIntelligenceEnabled = 0

ref table fact_orders
ref table fact_order_items
ref table dim_customer
ref table dim_seller
ref table dim_product
ref table dim_date
ref table dim_geography
ref table coded_reviews
